# Copia este archivo como .env y reemplaza los valores con los datos de Neon.
SPRING_PROFILES_ACTIVE=
SPRING_DATASOURCE_URL=jdbc:postgresql://TU_HOST_NEON/TU_BASE_DE_DATOS?sslmode=require
SPRING_DATASOURCE_USERNAME=user_ejemplo
SPRING_DATASOURCE_PASSWORD=password_ejemplo

# Base64 de al menos 32 bytes aleatorios para firmar tokens HS256.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_BASE64_ALEATORIO
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# AWS S3 para documentos. Las credenciales se obtienen del proveedor de identidad AWS
# (por ejemplo, IAM Role en Render/AWS o AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY localmente).
AWS_REGION=us-east-1
S3_BUCKET=nombre-del-bucket
# Opcional para S3-compatible/LocalStack; en AWS dejar vacío.
S3_ENDPOINT=

# Worker de matching (generar un secreto aleatorio; no reutilizar JWT_SECRET).
MATCHING_WORKER_API_KEY=
MATCHING_WORKER_URL=http://matching-worker-api:8000
MATCHING_SCHEDULER_ENABLED=true
MATCHING_SCHEDULER_FIXED_DELAY_MS=3600000
MATCHING_SCHEDULER_INITIAL_DELAY_MS=60000
MATCHING_MAX_RECOMMENDATIONS_PER_PROJECT=50
# Configurar un agente identificable y un correo de contacto antes de agregar spiders.
MATCHING_WORKER_USER_AGENT=
# Modelo multilingüe local para proyectos y oportunidades de financiación.
MATCHING_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# Copia este archivo como .env y reemplaza los valores con los datos de Neon.
SPRING_PROFILES_ACTIVE=
SPRING_DATASOURCE_URL=jdbc:postgresql://TU_HOST_NEON/TU_BASE_DE_DATOS?sslmode=require
SPRING_DATASOURCE_USERNAME=user_ejemplo
SPRING_DATASOURCE_PASSWORD=password_ejemplo

# Base64 de al menos 32 bytes aleatorios para firmar tokens HS256.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_BASE64_ALEATORIO
JWT_EXPIRATION_MS=3600000
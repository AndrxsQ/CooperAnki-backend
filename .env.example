POSTGRES_USER=user_ejemplo
POSTGRES_PASSWORD=password_ejemplo
POSTGRES_DB=db_ejemplo

PGADMIN_DEFAULT_EMAIL=email@ejemplo.com
PGADMIN_DEFAULT_PASSWORD=password_ejemplo

SPRING_PROFILES_ACTIVE=profile_ejemplo
SPRING_DATASOURCE_URL=jdbc:postgresql://host_ejemplo:5432/db_ejemplo?sslmode=require&channel_binding=require
SPRING_DATASOURCE_USERNAME=user_ejemplo
SPRING_DATASOURCE_PASSWORD=password_ejemplo

# Base64 de al menos 32 bytes aleatorios para firmar tokens HS256.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_BASE64_ALEATORIO
JWT_EXPIRATION_MS=3600000